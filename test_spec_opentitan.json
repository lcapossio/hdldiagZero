    {"from": "rv_plic",       "to": "ibex",          "kind": "generic", "width": "IRQ", "route": {"points": [[1101, 645], [1050, 645], [1050, 720], [700, 720], [700, 126], [746, 126]]}, "label": {"segment": 3, "t": 0.14}}
  ]
