    {"from": "i2c_gpio",      "to": "rv_plic",     "kind": "generic", "width": "IRQ", "route": {"points": [[966, 645], [1010, 645], [1010, 720], [1566, 720], [1566, 690]]}, "label": {"segment": 2}},
    {"from": "aon_timer",     "to": "rv_plic",     "kind": "generic", "width": "IRQ"},
    {"from": "rv_plic",       "to": "ibex",        "kind": "generic", "width": "IRQ", "route": {"points": [[1676, 645], [1720, 645], [1720, 720], [700, 720], [700, 126], [746, 126]]}, "label": {"segment": 3, "t": 0.14}}
