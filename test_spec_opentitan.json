    {"id": "alert_handler", "domain": "secure", "domain_b": "aon",         "row": 2, "col": 1, "lines": ["Alert Handler", "fault response"]},
    {"id": "xbar_peri",     "domain": "peri", "domain_b": "bus",           "row": 2, "col": 3, "lines": ["Peripheral", "Xbar", "TL-UL fanout"]},
    {"id": "peripherals",   "domain": "peri",                              "row": 2, "col": 4, "lines": ["I/O Peripherals", "UART / SPI", "I2C / GPIO"], "w": 190, "h": 72},

